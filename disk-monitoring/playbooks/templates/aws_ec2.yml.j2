# Generated by playbooks/00_discover.yml - do not edit by hand.
# Account: {{ account.name }} ({{ account.id }})
plugin: amazon.aws.aws_ec2
profile: {{ profile_prefix }}{{ account.id }}
regions: {{ aws_regions | to_json }}
filters:
  instance-state-name: running
# Owners can opt a VM out with tag DiskMonitoring=disabled
exclude_filters:
  - tag:DiskMonitoring:
      - disabled
hostnames:
  - instance-id
compose:
  aws_account_id: "'{{ account.id }}'"
  aws_account_name: "'{{ account.name }}'"
  aws_region: placement.region
  os_family: "'windows' if (platform | default('')) == 'windows' else 'linux'"
  # Every host is reached through SSM Session Manager - no SSH, no inbound ports.
  ansible_connection: "'amazon.aws.aws_ssm'"
  ansible_aws_ssm_instance_id: instance_id
  ansible_aws_ssm_profile: "'{{ profile_prefix }}{{ account.id }}'"
  ansible_aws_ssm_region: placement.region
  ansible_aws_ssm_bucket_name: "'{{ ssm_transfer_bucket }}'"
  ansible_aws_ssm_s3_addressing_style: "'virtual'"
keyed_groups:
  - key: os_family
    prefix: os
  - key: aws_account_id
    prefix: acct
  - key: placement.region
    prefix: region
  - key: ec2_tags.Environment | default('untagged')
    prefix: env
# Only ec2_tags is used; drop the deprecated `tags` hostvar (reserved name, removed after 2026-12-01).
use_deprecated_tags: false
strict: false

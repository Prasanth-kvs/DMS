{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProtectDiskMonitoringRoles",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:DeleteRolePermissionsBoundary",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::*:role/DiskMonitoringAnsibleRole",
        "arn:aws:iam::*:role/DiskMonitoringInstanceRole"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/AWSCloudFormationStackSetExecutionRole"
          ]
        }
      }
    },
    {
      "Sid": "ProtectMetricsLink",
      "Effect": "Deny",
      "Action": ["oam:DeleteLink", "oam:UpdateLink"],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/stacksets-exec-*",
            "arn:aws:iam::*:role/AWSCloudFormationStackSetExecutionRole"
          ]
        }
      }
    },
    {
      "Sid": "ProtectAgentConfigAndSelfHealing",
      "Effect": "Deny",
      "Action": [
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:UpdateDocument",
        "ssm:DeleteDocument",
        "ssm:DeleteAssociation"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/AmazonCloudWatch-disk-monitoring-*",
        "arn:aws:ssm:*:*:document/DiskMonitoring-*"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::*:role/DiskMonitoringAnsibleRole",
            "arn:aws:iam::*:role/stacksets-exec-*"
          ]
        }
      }
    }
  ]
}
